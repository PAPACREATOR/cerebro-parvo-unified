diff --git a/app/services/nexus_ace_music.py b/app/services/nexus_ace_music.py
new file mode 100644
--- /dev/null
+++ b/app/services/nexus_ace_music.py
@@ -0,0 +1,91 @@
+"""Local ACE-Step music provider; submit once and retain the job for resumption."""
+import hashlib
+import json
+import math
+from pathlib import Path
+import time
+import urllib.parse
+import urllib.request
+
+BASE_URL = 'http://127.0.0.1:8001'
+MAX_PROMPT_LENGTH = 1000
+
+class AceMusicError(RuntimeError):
+    pass
+
+def _request(route, payload=None):
+    data = None if payload is None else json.dumps(payload).encode('utf-8')
+    req = urllib.request.Request(BASE_URL + route, data, {'Content-Type': 'application/json'})
+    with urllib.request.urlopen(req, timeout=30) as response:
+        raw = response.read(2_000_001)
+    if len(raw) > 2_000_000:
+        raise AceMusicError('ACE-Step response exceeds limit')
+    value = json.loads(raw)
+    if value.get('code', 200) != 200 or value.get('error'):
+        raise AceMusicError('ACE-Step refused the request')
+    return value
+
+def is_enabled():
+    return True  # Local provider does not use a paid account or API key.
+
+def validate_generation_access():
+    try:
+        _request('/health')
+    except Exception as exc:
+        raise AceMusicError('A API local ACE-Step não está disponível na porta 8001') from exc
+
+def generate_bgm(video_path, output_path, video_duration, prompt=''):
+    try:
+        duration = float(video_duration)
+        if not math.isfinite(duration) or duration <= 0 or duration > 600:
+            raise AceMusicError('Music duration must be between 0 and 600 seconds')
+        prompt = str(prompt or 'Soft instrumental piano background, calm, no vocals').strip()
+        if not prompt or len(prompt) > MAX_PROMPT_LENGTH:
+            raise AceMusicError('Invalid music description')
+        output = Path(output_path).resolve()
+        from app.utils import utils
+        output.relative_to(Path(utils.task_dir()).resolve())
+        if output.suffix.lower() != '.wav':
+            raise AceMusicError('ACE-Step output must be WAV')
+        payload = dict(prompt=prompt, lyrics='[Instrumental]', audio_duration=max(10, duration),
+                       model='acestep-v15-turbo', inference_steps=8, thinking=False,
+                       use_cot_caption=False, use_cot_language=False, batch_size=1,
+                       bpm=90, key_scale='C major', time_signature='4/4', audio_format='wav')
+        fingerprint = hashlib.sha256(json.dumps(payload, sort_keys=True).encode()).hexdigest()
+        sidecar = output.with_suffix('.ace-job.json')
+        if sidecar.exists():
+            record = json.loads(sidecar.read_text(encoding='utf-8'))
+            if record['input_sha256'] != fingerprint:
+                raise AceMusicError('Existing music job has different parameters')
+            if not record.get('task_id'):
+                raise AceMusicError('Previous submission outcome unknown; inspect job before retrying')
+        else:
+            record = {'input_sha256': fingerprint, 'status': 'submitting'}
+            output.parent.mkdir(parents=True, exist_ok=True)
+            with sidecar.open('x', encoding='utf-8') as handle:
+                json.dump(record, handle)
+            response = _request('/release_task', payload)
+            record.update(task_id=response['data']['task_id'], status='submitted')
+            sidecar.write_text(json.dumps(record, indent=2), encoding='utf-8')
+        deadline = time.monotonic() + 900
+        while time.monotonic() < deadline:
+            rows = _request('/query_result', {'task_id_list': [record['task_id']]})['data']
+            if rows and rows[0]['status'] == 2:
+                raise AceMusicError('ACE-Step generation failed: ' + record['task_id'])
+            if rows and rows[0]['status'] == 1:
+                result = json.loads(rows[0]['result'])[0]
+                route = '/v1/audio?' + urllib.parse.urlencode({'path': result['file']})
+                with urllib.request.urlopen(BASE_URL + route, timeout=60) as response:
+                    audio = response.read(150_000_001)
+                if len(audio) > 150_000_000 or audio[:4] != b'RIFF' or audio[8:12] != b'WAVE':
+                    raise AceMusicError('ACE-Step returned invalid WAV')
+                output.write_bytes(audio)
+                record.update(status='completed', audio_sha256=hashlib.sha256(audio).hexdigest(), result=result)
+                sidecar.write_text(json.dumps(record, indent=2), encoding='utf-8')
+                return str(output)
+            time.sleep(3)
+        raise AceMusicError('Music job still pending; retained for resumption: ' + record['task_id'])
+    except AceMusicError:
+        raise
+    except Exception as exc:
+        raise AceMusicError('Local ACE-Step request failed: ' + str(exc)) from exc
